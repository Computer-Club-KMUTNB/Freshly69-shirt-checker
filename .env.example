# Copy to .env.local (local) and add the same keys in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # secret! server only

# Random string, 32+ chars. Signs the login cookie and derives the daily staff PIN.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# First-time PINs (6 digits). After the first admin login, change both in Admin → ตั้งค่า
# (values saved there override these).
ADMIN_PIN=
STAFF_PIN=
